# User or team service-account key. Usage bills to this key's Auto pool.
CURSOR_API_KEY=cursor_...
# Phone app sends this as Authorization: Bearer <token>.
RELAY_TOKEN=change-me
PORT=8787
DATA_DIR=./data
REQUEST_TIMEOUT_MS=60000
MAX_CONCURRENCY=2
# Optional. Run scripts/install-whisper.sh, then point these at the binary and model.
WHISPER_BIN=./whisper.cpp/build/bin/whisper-cli
WHISPER_MODEL=./whisper.cpp/models/ggml-base.en.bin
